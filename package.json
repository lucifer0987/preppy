{
  "name": "preppy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:local": "tsx --env-file-if-exists=.env.local scripts/preflight.ts local && cross-env APP_ENV=local next build && tsx --env-file-if-exists=.env.local scripts/check-bundle.ts",
    "start:local": "cross-env APP_ENV=local next start -p 3000",
    "build:prod": "tsx --env-file-if-exists=.env.local scripts/preflight.ts prod && npm run typecheck && npm run test && cross-env APP_ENV=production next build && tsx --env-file-if-exists=.env.local scripts/check-bundle.ts",
    "start:prod": "cross-env APP_ENV=production next start -p 3000",
    "build": "npm run build:prod",
    "start": "npm run start:prod",
    "seed": "tsx --env-file-if-exists=.env.local supabase/seed.ts",
    "migrate": "tsx --env-file-if-exists=.env.local supabase/migrate.ts",
    "secret": "tsx scripts/secret.ts",
    "check": "tsx scripts/parse.ts",
    "build:format": "tsx scripts/build-format.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "canvas-confetti": "^1.9.4",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  }
}
