{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preppy.local/schema/paper-v1.json",
  "title": "Preppy paper",
  "description": "The fixed JSON format for a daily Preppy paper. 55 questions, 4 sections, 45 minutes.",
  "type": "object",
  "required": ["format", "version", "date", "sections"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "preppy-paper" },
    "version": { "const": 1 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The night this paper goes live, YYYY-MM-DD."
    },
    "title": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "optionLabel": { "enum": ["A", "B", "C", "D", "E"] },
    "section": {
      "type": "object",
      "required": ["code", "questions"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["QUANT", "REASONING", "ENGLISH", "PK"] },
        "durationMinutes": { "type": "number", "minimum": 1, "maximum": 180 },
        "marksCorrect": { "type": "number", "minimum": 0.01, "maximum": 10 },
        "marksNegative": { "type": "number", "minimum": 0, "maximum": 10 },
        "directions": { "type": "array", "items": { "$ref": "#/$defs/directions" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      }
    },
    "directions": {
      "type": "object",
      "required": ["from", "to", "text"],
      "additionalProperties": false,
      "description": "Shared material: a reading passage, a data table, or a puzzle. Applies to questions from..to inclusive.",
      "properties": {
        "from": { "type": "integer", "minimum": 1, "maximum": 55 },
        "to": { "type": "integer", "minimum": 1, "maximum": 55 },
        "text": { "type": "string", "minLength": 1 },
        "table": { "$ref": "#/$defs/table" },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "table": {
      "type": "object",
      "required": ["headers", "rows"],
      "additionalProperties": false,
      "description": "Structured table data. Never rely on aligned spaces inside text; a PDF collapses them.",
      "properties": {
        "headers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["number", "text", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 55 },
        "text": { "type": "string", "minLength": 10 },
        "options": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 5,
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/optionLabel" },
          "patternProperties": { "^[A-E]$": { "type": "string", "minLength": 1 } }
        },
        "answer": { "$ref": "#/$defs/optionLabel" },
        "solution": { "type": "string" },
        "tag": { "type": "string" },
        "difficulty": { "enum": ["Easy", "Medium", "Hard"] },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
