{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preppy.local/schema/paper-v1.json",
  "title": "Preppy paper",
  "description": "The JSON format for a Preppy paper. Four sections in a fixed order; how many questions each holds, how long it runs and what it is worth all come from the configured pattern unless the file says otherwise.",
  "type": "object",
  "required": [
    "format",
    "version",
    "date",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "preppy-paper"
    },
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The day this paper runs, YYYY-MM-DD. The times within that day are chosen when it is scheduled, not here."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "What students and the archive call this paper. Optional: leave it out and the paper is known by its date. The upload screen offers a name box that overrides whatever is here, so a file that names itself badly can be fixed without editing it, and a paper can be renamed afterwards from Manage."
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "Exactly four, in this order: QUANT, REASONING, ENGLISH, PK.",
      "prefixItems": [
        {
          "$ref": "#/$defs/section",
          "properties": {
            "code": {
              "const": "QUANT"
            }
          }
        },
        {
          "$ref": "#/$defs/section",
          "properties": {
            "code": {
              "const": "REASONING"
            }
          }
        },
        {
          "$ref": "#/$defs/section",
          "properties": {
            "code": {
              "const": "ENGLISH"
            }
          }
        },
        {
          "$ref": "#/$defs/section",
          "properties": {
            "code": {
              "const": "PK"
            }
          }
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "optionLabel": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "code",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "QUANT",
            "REASONING",
            "ENGLISH",
            "PK"
          ]
        },
        "questionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "How many questions this section holds, when that differs from the default pattern. Omit to use the pattern. If given, it must equal the length of \"questions\"."
        },
        "durationMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 180
        },
        "marksCorrect": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        },
        "marksNegative": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directions"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "directions": {
      "type": "object",
      "required": [
        "from",
        "to",
        "text"
      ],
      "additionalProperties": false,
      "description": "Shared material: a reading passage, a data table, or a puzzle. Applies to questions from..to inclusive.",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800,
          "description": "First question this material covers."
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800,
          "description": "Last question this material covers, inclusive."
        },
        "text": {
          "type": "string",
          "pattern": "\\S",
          "description": "Must contain something other than spaces."
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Gg][Ii][Ff])$"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "headers",
        "rows"
      ],
      "additionalProperties": false,
      "description": "Structured table data. Never rely on aligned spaces inside text; the browser collapses them.",
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "number",
        "text",
        "options",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800,
          "description": "Position within the paper: unique per section, continuous across the paper, and inside the band its section owns. The ceiling is four sections at the Paper pattern screen's own maximum of 200 a section, not the count of any one exam pattern."
        },
        "text": {
          "type": "string",
          "pattern": "^\\s*\\S[\\s\\S]{8,}\\S\\s*$",
          "description": "At least 10 characters, not counting spaces at either end."
        },
        "options": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 5,
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/$defs/optionLabel"
          },
          "patternProperties": {
            "^[A-E]$": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "answer": {
          "$ref": "#/$defs/optionLabel"
        },
        "solution": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "Easy",
            "Medium",
            "Hard"
          ],
          "description": "Leave it out rather than empty."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Gg][Ii][Ff])$"
          }
        }
      }
    }
  }
}
