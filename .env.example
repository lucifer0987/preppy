# Copy to .env.local and fill in from your Supabase project.
#
#   cp -n .env.example .env.local
#
# The -n matters: a plain cp overwrites an .env.local you have already filled
# in, and there is no copy of it anywhere else.
#
# Supabase dashboard -> Settings -> API Keys

# Project URL. Also shown on the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable key, sb_publishable_... Safe in the browser: row-level
# security denies everything by default, so on its own it reads nothing.
#
# Supabase is retiring the older `anon` key (a long JWT starting eyJ) but both
# still work. If that is what you have, put it in NEXT_PUBLIC_SUPABASE_ANON_KEY
# instead and leave this blank -- the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A secret key, sb_secret_... SECRET.
# This bypasses every access rule. It must never appear in client code, never be
# committed, and never be sent to the browser. Every build scans the browser
# bundle for it and fails if it is there.
#
# The older `service_role` key does the same job and still works; put it in
# SUPABASE_SERVICE_ROLE_KEY instead if that is what you have.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A random string. Vercel Cron presents it to /api/cron/finalise so the
# endpoint cannot be triggered by anyone else. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Only needed to run migrations automatically (npm run migrate).
# Supabase dashboard -> the "Connect" button at the top -> Session pooler.
#
# Take the SESSION pooler, not the direct connection: the direct one is
# IPv6-only unless you pay for the IPv4 add-on, and most home and office
# networks are IPv4. Session mode is IPv4 on every plan and supports everything
# a migration needs. Not the Transaction pooler on 6543 -- that one has no
# prepared statements and the runner uses them.
#
#   postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Without it, `npm run migrate` prints the SQL for you to paste instead.
DATABASE_URL=
