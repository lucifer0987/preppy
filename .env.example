# Copy this to .env.local and fill it in from your Supabase project.
#
#   cp -n .env.example .env.local
#
# The -n matters. A plain cp overwrites an .env.local you have already filled
# in, and since this file is git-ignored there is no copy to restore from.
#
# Nothing here is read by the browser except the two NEXT_PUBLIC_ lines.


# ---------------------------------------------------------------- the project
# Supabase dashboard -> the "Connect" button at the top. The project URL is
# shown there, and also on Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co


# ------------------------------------------------------------------- the keys
# Supabase dashboard -> Settings -> API Keys.
#
# That page shows two generations of key and both work. Prefer the current
# pair; Supabase is retiring the older one.
#
#   current   sb_publishable_...   sb_secret_...
#   legacy    a long JWT starting eyJ, labelled "anon" and "service_role"
#
# Fill in the pair you have. If yours are the legacy ones, comment out the line
# below and uncomment the one under it instead -- the app accepts either name,
# and having both set is fine but pointless.

# Safe in the browser. Row-level security denies everything by default, so this
# key on its own reads nothing at all.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. This bypasses every access rule in the database. It must never appear
# in client code, never be committed, and never reach the browser. Every build
# scans the browser bundle for it and fails if it is there.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# ----------------------------------------------------------- the nightly job
# A random string. Vercel Cron presents it to /api/cron/finalise so that nobody
# else can trigger a scoring run. Only needed in production.
#
#   npm run secret
CRON_SECRET=


# -------------------------------------------------------------- migrations
# Only used by `npm run migrate`, never by the app itself. Without it the runner
# prints the SQL for you to paste into the Supabase SQL editor instead.
#
# Supabase dashboard -> "Connect" -> Session pooler.
#
# Take the SESSION pooler. The direct connection is IPv6-only unless you pay for
# the IPv4 add-on, and home and office networks are almost always IPv4, so it
# simply cannot be reached. The transaction pooler on 6543 has no prepared
# statements, which the runner uses. Session mode is IPv4 on every plan and
# supports everything a migration needs.
#
# You can tell it apart by the username, which carries the project ref:
#
#   postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# URL-encode any @ : / or # in the password, or the address will not parse.
DATABASE_URL=
