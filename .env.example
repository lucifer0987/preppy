# Copy to .env.local and fill in from your Supabase project.
# Supabase dashboard -> Settings -> API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project API keys -> anon / public. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project API keys -> service_role. SECRET.
# This bypasses every access rule. It must never appear in client code,
# never be committed, and never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# A random string. Vercel Cron presents it to /api/cron/finalise so the
# endpoint cannot be triggered by anyone else. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Only needed to run migrations automatically (npm run migrate).
# Supabase dashboard -> the "Connect" button at the top -> Session pooler.
#
# Take the SESSION pooler, not the direct connection: the direct one is
# IPv6-only unless you pay for the IPv4 add-on, and most home and office
# networks are IPv4. Session mode is IPv4 on every plan and supports everything
# a migration needs. Not the Transaction pooler on 6543 -- that one has no
# prepared statements and the runner uses them.
#
#   postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Without it, `npm run migrate` prints the SQL for you to paste instead.
DATABASE_URL=
