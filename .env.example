# Copy to .env.local and fill in from your Supabase project.
# Supabase dashboard -> Settings -> API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project API keys -> anon / public. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project API keys -> service_role. SECRET.
# This bypasses every access rule. It must never appear in client code,
# never be committed, and never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
